# 로컬 개발환경 예시 — 이 파일은 자리표시자만 커밋한다.
# 실제 값은 gitignore된 apps/api/.env(또는 루트 .env)에서만 관리한다.
# (docs/design/db-schema-design.md §키·pepper 관리 관례 준수)
#
# 파일명 안내: 원래 계획은 `.env.example`이었으나, 이 실행 환경의 파일쓰기 권한
# 정책이 내용과 무관하게 `.env*` 경로 패턴 자체를 전면 차단한다(Write/Bash 도구
# 모두 거부됨 — 자리표시자만 있는 파일도 예외 없음). 이는 02-01-SUMMARY.md에
# Rule 3(차단 이슈) 편차로 기록되어 있다. 로컬에서 사용할 때는 이 파일을
# `.env`로 복사한 뒤 실제 값을 채워 넣는다: `cp env.example .env`

# --- Database (docker-compose.yml postgres 서비스와 매칭) ---
DATABASE_URL=<REDACTED>

# --- Redis (docker-compose.yml redis 서비스와 매칭, BullMQ 브로커) ---
REDIS_URL=<REDACTED>

# --- Auth ---
JWT_SECRET=<REDACTED>

# --- 사업자등록번호 암호화 (애플리케이션 레벨 AEAD — 02-01 checkpoint:decision 확정값) ---
# AES-256-GCM 암호화 키. Node crypto.randomBytes(32)로 생성한 32바이트 키를 base64로 인코딩해 보관한다.
BUSINESS_REG_NO_ENCRYPTION_KEY=<REDACTED>
# HMAC-SHA256 다이제스트 계산용 pepper. 단순 SHA-256 대신 이 pepper를 섞어야 한다(db-schema-design.md §민감정보 저장 규칙).
BUSINESS_REG_NO_HMAC_PEPPER=<REDACTED>

# --- 국세청 사업자등록정보 진위확인 API (PROF-05, 02-03) ---
# data.go.kr 활용신청 승인 후 발급되는 서비스키. 정확한 엔드포인트/파라미터는 RESEARCH.md
# Open Question 2로 미확정 — 승인 후 nts-verification.adapter.ts를 재확인해야 한다.
NTS_API_KEY=<REDACTED>

# --- 공고 배치 수집 (02-05, ING-01~03) ---
# 'fixture'(기본값, 나라장터 API 미승인 상태) | 'g2b'(실제 API 활성화 — 승인 후 전환)
ANNOUNCEMENT_SOURCE=fixture
# ANNOUNCEMENT_SOURCE=g2b일 때만 사용. 나라장터 입찰공고정보서비스 활용신청 승인 후 발급되는 서비스키.
NARAJANGTEO_API_KEY=<REDACTED>
# BullMQ 리피터블 잡 크론 표현식. 기본값 4시간(하루 6회) — 나라장터 실제 일일 호출 한도 확인 후 조정 필요
# (02-RESEARCH.md Pitfall 3, Open Question 1).
INGEST_CRON_PATTERN=0 0 */4 * * *
